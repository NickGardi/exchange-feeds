# Application
APP_NAME=exchange-feeds
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
TESTING=false

# Symbols to track (comma-separated, normalized, no separators)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Quote freshness: ignore an exchange quote older than this
STALE_QUOTE_SECONDS=60

# Persist a snapshot of best bid/ask this often
SNAPSHOT_INTERVAL_SECONDS=15

# Log a warning when mid price moves by this percent within the lookback window
ALERT_MOVE_PCT=0.5
ALERT_COOLDOWN_SECONDS=15

# PostgreSQL (optional locally; recommended in production)
# Example: postgresql+asyncpg://feeds:feeds@localhost:5432/feeds
DATABASE_URL=

# Redis (optional locally; hot cache of latest prices + producer feed status)
# Example: redis://localhost:6379/0
REDIS_URL=

# Class pipeline (leave empty for in-process WebSocket feeds)
# Compose sets these so FastAPI reads Redis/Cassandra instead of attaching feeds.
CASSANDRA_HOST=
CASSANDRA_KEYSPACE=feeds
KAFKA_BOOTSTRAP_SERVERS=
RUN_LOCAL_FEEDS=false

# Require backing services to start (set true on Fly.io if you always attach them)
REQUIRE_DATABASE=false
REQUIRE_REDIS=false

FROM bitnami/spark:3.5.1

USER root
RUN pip install --no-cache-dir redis==6.4.0
COPY spark/stream_best_prices.py /opt/bitnami/spark/jobs/stream_best_prices.py
USER 1001

# Kafka + Cassandra connectors download on first start (needs network).
CMD ["/opt/bitnami/spark/bin/spark-submit", \
     "--master", "local[2]", \
     "--conf", "spark.jars.ivy=/tmp/ivy", \
     "--packages", "org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1,com.datastax.spark:spark-cassandra-connector_2.12:3.5.1", \
     "/opt/bitnami/spark/jobs/stream_best_prices.py"]
